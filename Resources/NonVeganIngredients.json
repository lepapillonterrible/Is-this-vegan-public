  "ambiguous": [
    {
      "name": "lecithin",
      "aliases": ["E322"],
      "note": "Often soy-derived (vegan), but can be from eggs. Check source."
    },
    {
      "name": "glycerin",
      "aliases": ["glycerine", "glycerol", "E422"],
      "note": "Can be plant-derived (vegan) or animal-derived. Source usually not specified."
    },
    {
      "name": "stearic acid",
      "aliases": ["E570", "stearate"],
      "note": "Can be plant-derived (coconut, palm) or animal-derived (tallow)."
    },
    {
      "name": "vitamin d3",
      "aliases": ["cholecalciferol", "D3"],
      "note": "Usually derived from lanolin (sheep wool), but vegan versions from lichen exist. Vitamin D2 (ergocalciferol) is always vegan."
    },
    {
      "name": "omega-3",
      "aliases": ["omega 3", "DHA", "EPA"],
      "note": "Usually from fish oil, but algae-based vegan versions exist. Check for 'algae-derived'."
    },
    {
      "name": "natural flavors",
      "aliases": ["natural flavoring", "natural flavours", "natural flavour"],
      "note": "Can be plant or animal-derived. Impossible to tell without contacting manufacturer."
    },
    {
      "name": "mono and diglycerides",
      "aliases": ["E471", "monoglycerides", "diglycerides", "glycerol monostearate"],
      "note": "Can be plant or animal-derived. Common in bread and baked goods."
    },
    {
      "name": "lactic acid",
      "aliases": ["E270"],
      "note": "Usually produced by bacterial fermentation (vegan), but can be animal-derived. Almost always vegan in practice."
    },
    {
      "name": "vitamin A",
      "aliases": ["retinol", "retinyl palmitate", "retinyl acetate"],
      "note": "Can be from fish liver oil or synthetic (vegan). Beta-carotene-derived vitamin A is always vegan."
    },
    {
      "name": "L-cysteine",
      "aliases": ["E920", "cysteine"],
      "note": "Often derived from human hair or duck feathers. Synthetic versions exist and are common in modern bread improvers."
    },
    {
      "name": "sugar",
      "aliases": ["refined sugar", "white sugar", "cane sugar"],
      "note": "Some white cane sugar is filtered through bone char. Beet sugar, organic sugar, and unrefined sugars are always vegan."
    },
    {
      "name": "palm oil",
      "aliases": ["palm fat", "palm kernel oil", "น้ำมันปาล์ม"],
      "note": "Technically vegan but controversial due to environmental impact and animal habitat destruction."
    },
    {
      "name": "carrageenan",
      "aliases": ["E407", "irish moss extract"],
      "note": "Derived from seaweed (vegan), but can be processed with animal products. Considered vegan by most standards."
    },
    {
      "name": "vitamin B12",
      "aliases": ["cyanocobalamin", "methylcobalamin"],
      "note": "Synthetic B12 is vegan. Some supplements may use animal-derived carriers. Fortified foods use synthetic B12 (vegan)."
    },
    {
      "name": "iodine",
      "aliases": ["potassium iodide"],
      "note": "In supplements, sometimes derived from animal thyroid tissue. Iodized salt uses synthetic iodine (vegan)."
    },
    {
      "name": "caprylic acid",
      "aliases": ["capric acid", "E570", "octanoic acid"],
      "note": "Can be derived from coconut/palm oil (vegan) or dairy fat (not vegan). Usually plant-derived in food products."
    },
    {
      "name": "polysorbate 80",
      "aliases": ["E433", "polysorbate 60", "E435"],
      "note": "Usually vegan (synthetic from sorbitol), but the fatty acid component can be animal-derived."
    },
    {
      "name": "magnesium stearate",
      "aliases": ["E470b"],
      "note": "Stearic acid component can be from animal fat or plant-derived. Often vegan but not guaranteed."
    }
  ]
}
