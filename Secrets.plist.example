<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Copy this file to Resources/Secrets.plist and replace
        the placeholders with your actual keys.
        
        Get a free Gemini key at: https://aistudio.google.com/apikey
        
        IMPORTANT: Resources/Secrets.plist is gitignored — never
        commit your real API keys or URLs to version control.
    -->
    <key>GEMINI_API_KEY</key>
    <string>YOUR_KEY_HERE</string>
    <key>BACKEND_PROXY_URL</key>
    <string>https://is-this-vegan-proxy.YOUR_SUBDOMAIN.workers.dev</string>
</dict>
</plist>
